[Unit]
Description=FinBERT Sentiment Analysis Server (Node.js)
After=network.target

[Service]
Type=simple
User=chester_kim
WorkingDirectory=/home/chester_kim/atn-trd/finbert-server
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=FINBERT_MODEL_PATH=/home/chester_kim/finbert-onnx
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
