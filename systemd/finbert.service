[Unit]
Description=FinBERT Sentiment Analysis Service
After=network.target

[Service]
Type=simple
User=violckim_gmail_com
WorkingDirectory=/home/violckim_gmail_com/atn-trd/finbert-server
Environment=FINBERT_MODEL_PATH=/home/violckim_gmail_com/finbert-onnx
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 127.0.0.1 --port 5000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
