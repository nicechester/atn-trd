[Unit]
Description=ATN-TRD Trading App
After=network.target

[Service]
Type=simple
User=violckim_gmail_com
WorkingDirectory=/home/violckim_gmail_com/atn-trd
EnvironmentFile=/home/violckim_gmail_com/.env
Environment=NODE_ENV=production
Environment=FINBERT_MODEL_PATH=/home/violckim_gmail_com/finbert-onnx
ExecStart=/usr/bin/node server/dist/main.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
