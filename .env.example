# Required: Encryption key for secrets (generate with: openssl rand -hex 32)
ATN_ENC_KEY=

# Optional: Role for the Node process (all|web|worker, default: all)
ATN_ROLE=all

# Optional: Data directory for database and files (default: ./data)
ATN_DATA_DIR=./data

# Optional: Port (default: 8080)
PORT=8080

# Optional: Node environment (development|production)
NODE_ENV=development
