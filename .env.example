# Required: Encryption key for secrets (generate with: openssl rand -hex 32)
ATN_ENC_KEY=

# Optional: Role for the Node process (all|web|worker, default: all)
ATN_ROLE=all

# Optional: Data directory for database and files (default: ./data)
ATN_DATA_DIR=./data

# Optional: Port (default: 8080)
PORT=8080

# Optional: Node environment (development|production)
NODE_ENV=development

# Optional data source keys. Preferred: store them via Settings -> Secrets
# (encrypted at rest); these env vars are the fallback.
# News connector, provider "finnhub" (free tier, 60 req/min).
# The "yahoo" news provider needs no key.
FINNHUB_API_KEY=
# Macro connector (FRED, free registration).
FRED_API_KEY=
